# ─────────────────────────────────────────────────────────────
# CampusCore – Lecturer Portal backend (copy to .env and fill in)
# NEVER commit .env. These values are server-side secrets.
# All four portals use the SAME Supabase project and DATABASE_URL.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# Ports: student 5001, lecturer 5002, lab-teacher 5003, admin 5004
PORT=5002
# Only needed if the frontend is served from a different origin (Vite dev uses a proxy, so usually not)
CLIENT_URL=

# Supabase Postgres connection string.
# Supabase Dashboard → Connect → "Session pooler" (IPv4-compatible). Do NOT add ?sslmode=... here;
# SSL is configured in database/connection.js.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Set to false only for a local Postgres without SSL
DB_SSL=true
# Required when DB_SSL=true: path (relative to backend/) to Supabase's CA certificate (Dashboard → Database → SSL); the server certificate is fully verified
DB_SSL_CA_PATH=certs/prod-ca-2021.crt

# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key: server-side only. Used for seeding auth users and for the private Storage
# buckets (the backend uploads/downloads files after checking permissions).
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only for projects still using the legacy HS256 JWT secret.
# Leave empty for projects using JWT signing keys (default for new projects) – tokens are then
# verified against the project's public JWKS.
SUPABASE_JWT_SECRET=

# Supabase Storage (private bucket created by `npm run storage:setup`) and upload limit
MATERIALS_BUCKET=course-materials
SUBMISSIONS_BUCKET=student-submissions
MAX_UPLOAD_MB=10

# Password given to every seeded *test* account (fictional users only). Min 10 characters.
SEED_DEFAULT_PASSWORD=
