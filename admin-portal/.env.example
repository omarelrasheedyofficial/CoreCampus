# Administrator portal frontend (copy to .env). Everything prefixed VITE_ is bundled into the
# browser, so ONLY public values belong here — never the service-role key or DB password.

# Supabase Dashboard → Project Settings → API (same project as every other portal)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The anon / publishable key (public by design; table access is blocked by RLS — see migration 001)
VITE_SUPABASE_ANON_KEY=

# Other CampusCore portals (used for role-aware links between portals)
VITE_STUDENT_PORTAL_URL=http://localhost:5173
VITE_LECTURER_PORTAL_URL=http://localhost:5174
VITE_LAB_TEACHER_PORTAL_URL=http://localhost:5175
